---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/tree-*.webp", { eager: true });
const imgFor = (key: string) => images[`../assets/${key}.webp`]?.default;

const trees = await getCollection("trees");
const species = [...new Set(trees.map((t) => t.data.name))];
const allSizes = ["Shito", "Mame", "Shohin", "Medium", "Large", "XL"];
const sizes = allSizes.filter((z) => trees.some((t) => t.data.size === z));
const styles = [...new Set(trees.map((t) => t.data.style))];
const statuses = ["Available", "Reserved", "Sold", "Exported"];
---

<section class="section" id="collection" style="background: var(--ink-2); border-block: 1px solid var(--hairline-soft);">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 class="section-title">The Collection</h2>
      <p class="section-note">Every tree is one of one. Filter by species, size, style, or availability — then inquire.</p>
    </div>

    <div class="filters reveal" role="group" aria-label="Filter collection">
      <div class="filter-group" data-filter="species">
        <span class="filter-label">Species</span>
        <button class="chip active" data-value="">All</button>
        {species.map((s) => <button class="chip" data-value={s}>{s}</button>)}
      </div>
      <div class="filter-group" data-filter="size">
        <span class="filter-label">Size</span>
        <button class="chip active" data-value="">All</button>
        {sizes.map((s) => <button class="chip" data-value={s}>{s}</button>)}
      </div>
      <div class="filter-group" data-filter="style">
        <span class="filter-label">Style</span>
        <button class="chip active" data-value="">All</button>
        {styles.map((s) => <button class="chip" data-value={s}>{s}</button>)}
      </div>
      <div class="filter-group" data-filter="status">
        <span class="filter-label">Status</span>
        <button class="chip active" data-value="">All</button>
        {statuses.map((s) => <button class="chip" data-value={s}>{s}</button>)}
      </div>
    </div>

    <div class="collection-grid" id="collectionGrid">
      {trees.map((t) => {
        const d = t.data;
        return (
          <a href="#contact" class="tree-card reveal"
             data-species={d.name} data-size={d.size} data-style={d.style} data-status={d.status}>
            <div class="tree-photo">
              <Image src={imgFor(d.image)} alt={`${d.name} bonsai, ${d.style}`} />
            </div>
            <h3>{d.name}</h3>
            <p class="tree-latin">{d.latin}</p>
            <div class="mini-facts">
              <span>{d.size}</span><span>{d.style}</span>
              <span class={`status ${d.status.toLowerCase()}`} style="font-size:0.68rem">{d.status}</span>
            </div>
          </a>
        );
      })}
    </div>
    <p class="empty-note" id="emptyNote">No trees match this combination — try widening the filters, or <a href="#contact" style="color:var(--amber)">ask us directly</a>.</p>
  </div>
</section>

<script>
  const groups = document.querySelectorAll(".filter-group");
  const cards = document.querySelectorAll(".tree-card");
  const emptyNote = document.getElementById("emptyNote");
  const active = { species: "", size: "", style: "", status: "" };

  groups.forEach((g) => {
    const key = g.getAttribute("data-filter");
    g.querySelectorAll(".chip").forEach((chip) => {
      chip.addEventListener("click", () => {
        g.querySelectorAll(".chip").forEach((c) => c.classList.remove("active"));
        chip.classList.add("active");
        active[key] = chip.getAttribute("data-value");
        apply();
      });
    });
  });

  function apply() {
    let visible = 0;
    cards.forEach((c) => {
      const show =
        (!active.species || c.dataset.species === active.species) &&
        (!active.size || c.dataset.size === active.size) &&
        (!active.style || c.dataset.style === active.style) &&
        (!active.status || c.dataset.status === active.status);
      c.classList.toggle("hidden", !show);
      if (show) visible++;
    });
    emptyNote.classList.toggle("show", visible === 0);
  }
</script>
