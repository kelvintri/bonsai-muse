---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/tree-*.webp", { eager: true });
const imgFor = (key: string) => images[`../assets/${key}.webp`]?.default;

const all = await getCollection("trees");
const bySlug = Object.fromEntries(all.map((t) => [t.id.replace(/\.md$/, ""), t]));
const featuredSlugs = ["santigi", "sancang", "cemara"];
const featured = featuredSlugs.map((s) => bySlug[s]).filter(Boolean);
---

<section class="section" id="featured">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 class="section-title">Featured Bonsai</h2>
      <p class="section-note">Three trees that define the gallery — each one cultivated, styled, and finished by hand in Bali.</p>
    </div>

    {featured.map(async (t, i) => {
      const { Content } = await render(t);
      const d = t.data;
      return (
        <article class={`featured-tree reveal ${i % 2 === 1 ? "flip" : ""}`}>
          <div class="tree-photo">
            <Image src={imgFor(d.image)} alt={`${d.name} bonsai, ${d.style}`} />
          </div>
          <div>
            <p class="tree-meta">{d.origin} · {d.size} · {d.style}</p>
            <h3 class="tree-name">{d.name}</h3>
            <p class="tree-latin">{d.latin}</p>
            <div style="color: var(--bone-dim)"><Content /></div>
            <dl class="tree-facts">
              <div><dt>Species</dt><dd>{d.latin}</dd></div>
              <div><dt>Origin</dt><dd>{d.origin}</dd></div>
              <div><dt>Size</dt><dd>{d.size}</dd></div>
              <div><dt>Style</dt><dd>{d.style}</dd></div>
            </dl>
            <span class={`status ${d.status.toLowerCase()}`}>{d.status}</span>
          </div>
        </article>
      );
    })}
  </div>
</section>
