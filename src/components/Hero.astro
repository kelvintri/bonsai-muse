---
import { Image } from "astro:assets";
import heroImg from "../assets/hero.webp";
---

<header class="hero" id="top">
  <div class="hero-media">
    <Image src={heroImg} alt="Masterpiece bonsai photographed at night in the Bali garden" loading="eager" />
  </div>
  <div class="hero-content">
    <h1>Bonsai D'Uma Bali</h1>
    <p class="tagline">Living Art. Shaped by Nature. <em>Crafted in Bali.</em></p>
    <div class="hero-ctas">
      <a class="btn" href="#collection">Explore Collection <span class="arrow">→</span></a>
      <a class="btn" href="#visit">Visit Our Garden <span class="arrow">→</span></a>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">Scroll</div>
</header>
